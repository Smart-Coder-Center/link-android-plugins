{
  "id": "ml-translate",
  "kind": "translation",
  "version": "1.0.22",
  "name": "Smart Translate",
  "description": "Detects language, extracts Persian and English text from images offline, and translates on-device with managed offline language models.",
  "language": "und",
  "min_link_version": "2.21.0",
  "package_type": "native_runtime",
  "license": {
    "name": "Apache-2.0",
    "attribution": "Google ML Kit Translation and Language Identification APIs; Tesseract4Android OCR"
  },
  "dependencies": [
    {
      "id": "asr.koochik-rnnt.fa",
      "package_type": "data",
      "version": "1.0.0-test.2"
    },
    {
      "id": "tts.mana.piper.fa",
      "package_type": "data",
      "version": "1.0.1"
    }
  ],
  "release_notes": "Replaces Latin-only image OCR with the same offline Tesseract 4.9.0 Persian+English engine and fas/eng models used by Document Editor. OCR runs inside the optional Smart Translate plugin; Link APK size is unchanged. ML Kit translation and bundled Language ID remain unchanged.",
  "runtime": {
    "abis": [
      "arm64-v8a"
    ],
    "load_order": [
      "lib/arm64-v8a/liblanguage_id_l2c_jni.so",
      "lib/arm64-v8a/libtranslate_jni.so"
    ],
    "code_files": [
      "code/classes.dex"
    ],
    "entry_class": "eu.siacs.link.plugins.translate.MlKitTranslatePlugin",
    "code_api_version": 1
  },
  "source": {
    "type": "mlkit_translate_runtime",
    "translate_version": "17.0.2",
    "language_id_version": "17.0.6",
    "language_id_provider": "com.google.mlkit:language-id",
    "common_version": "18.11.0",
    "okhttp_version": "3.12.13",
    "okio_version": "1.15.0",
    "text_recognition_version": "19.0.1",
    "text_recognition_common_version": "19.1.0",
    "vision_interfaces": "transitive_plugin_local",
    "language_id_flow": "bundled_model",
    "tesseract4android_version": "4.9.0",
    "tessdata_fast_revision": "87416418657359cb625c412a48b6e1d6d41c29bd",
    "ocr_languages": [
      "fas",
      "eng"
    ],
    "ocr_engine": "tesseract4android_offline"
  }
}
